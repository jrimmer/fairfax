[Desktop Entry]
Type=Application
Name=Fairfax
GenericName=Task Manager
Comment=A keyboard-first task manager, modelled on the reference app
Exec=fairfax %u
MimeType=x-scheme-handler/fairfax;
Icon=fairfax
Terminal=false
Categories=Office;ProjectManagement;Utility;
Keywords=todo;tasks;gtd;taskapp;
StartupWMClass=fairfax
Actions=new-task;new-window;today;find;

[Desktop Action new-task]
Name=New Task
Exec=fairfax --quick

[Desktop Action today]
Name=Today
Exec=fairfax fairfax://x-callback-url/showtoday

[Desktop Action find]
Name=Find a Task
Exec=fairfax --open

[Desktop Action new-window]
Name=New Window
Exec=fairfax --new-window
