[Desktop Entry]
Type=Application
Name=Precrime
GenericName=Task Manager
Comment=A keyboard-first task manager, modelled on the reference app
Exec=precrime %u
MimeType=x-scheme-handler/precrime;
Icon=precrime
Terminal=false
Categories=Office;ProjectManagement;Utility;
Keywords=todo;tasks;gtd;taskapp;
StartupWMClass=precrime
Actions=new-task;new-window;today;find;

[Desktop Action new-task]
Name=New Task
Exec=precrime --quick

[Desktop Action today]
Name=Today
Exec=precrime precrime://x-callback-url/showtoday

[Desktop Action find]
Name=Find a Task
Exec=precrime --open

[Desktop Action new-window]
Name=New Window
Exec=precrime --new-window
