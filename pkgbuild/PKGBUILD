# Maintainer: Jason Rimmer <jason@rimmer.net>
pkgname=fairfax
pkgver=$(sed -n 's/^[[:space:]]*VERSION[[:space:]]*=[[:space:]]*//p' "$startdir/../fairfax.pro" | head -n1)
pkgrel=1
pkgdesc='A keyboard-first task manager for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/jrimmer/fairfax'
license=('MIT')
depends=('zlib' 'qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'git' 'python')
optdepends=('libsecret: keep the Todoist token in the keyring'
            'pipewire: record audio notes')
makedepends=('gcc' 'make' 'zlib')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  FAIRFAX_BIN=build/fairfax scripts/stage-install "$pkgdir" /usr
}
