#!/bin/bash
# Wires Fairfax into Omarchy, or takes it out again:
#
#   fairfax setup omarchy             add Quick Entry key, window rules, autostart, menu entries
#   fairfax setup omarchy --remove    undo all of it
#   fairfax setup omarchy --key "SUPER + ALT + T"    use another Quick Entry key
#
# Everything Fairfax adds to Hyprland lives in ~/.config/hypr/fairfax.lua,
# loaded by one marked line in hyprland.lua; launcher entries are a marked
# block in ~/.config/omarchy/extensions/omarchy-menu.jsonc. Files are backed
# up before they change, and Hyprland's config is validated afterwards.

set -euo pipefail

hypr="$HOME/.config/hypr"
module="$hypr/fairfax.lua"
main="$hypr/hyprland.lua"
menu="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
require_line='require("hypr.fairfax") -- fairfax: added by `fairfax setup omarchy`'
key="SUPER + SHIFT + T"
remove=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --remove) remove=true ;;
    --key) key="$2"; shift ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "fairfax setup omarchy: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

if [[ ! -f $main ]]; then
  echo "This doesn't look like Omarchy: $main is missing." >&2
  exit 1
fi

backup() { [[ -f $1 ]] && cp "$1" "$1.bak.$(date +%s)"; }

# The launcher's menu file is JSONC; Python edits it so commas stay valid.
edit_menu() {
  local mode="$1"
  mkdir -p "$(dirname "$menu")"
  [[ -f $menu ]] || printf '{\n}\n' >"$menu"
  backup "$menu"
  python3 - "$menu" "$mode" <<'PY'
import re, sys
path, mode = sys.argv[1], sys.argv[2]
text = open(path, encoding="utf-8").read()
begin, end = "// fairfax: begin", "// fairfax: end"
text = re.sub(r"\n?[ \t]*" + re.escape(begin) + r".*?" + re.escape(end) + r"[^\n]*\n?", "\n", text, flags=re.S)
if mode == "add":
    block = """  // fairfax: begin (added by `fairfax setup omarchy`)
  "fairfax": {"icon":"󰄲","label":"Fairfax","description":"Tasks: new task, Today, Quick Open"},
  "fairfax.new": {"icon":"󰐕","label":"New Task","action":"fairfax --quick","description":"Fairfax Quick Entry"},
  "fairfax.today": {"icon":"󰃭","label":"Today","action":"fairfax fairfax://x-callback-url/showtoday"},
  "fairfax.find": {"icon":"󰍉","label":"Find a Task","action":"fairfax --open","description":"Fairfax Quick Open"},
  "fairfax.settings": {"icon":"󰒓","label":"Settings","action":"fairfax --settings"},
  // fairfax: end
"""
    close = text.rstrip().rfind("}")
    head = text[:close].rstrip()
    # Strip comments to see whether earlier entries need a separating comma.
    bare = re.sub(r"//[^\n]*", "", head).rstrip()
    if bare and not bare.endswith(("{", ",")):
        head += ","
    text = head + "\n" + block + "}\n"
open(path, "w", encoding="utf-8").write(re.sub(r"\n{3,}", "\n\n", text))
PY
}

validate() {
  if command -v hyprctl >/dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    hyprctl reload >/dev/null
    local errors
    errors=$(hyprctl configerrors 2>/dev/null | grep -v '^$' || true)
    if [[ -n $errors && $errors != *"no errors"* ]]; then
      echo "Hyprland reports config errors:" >&2
      echo "$errors" >&2
      return 1
    fi
  fi
}

if $remove; then
  [[ -f $module ]] && rm "$module" && echo "Removed $module"
  if grep -qF 'require("hypr.fairfax")' "$main"; then
    backup "$main"
    sed -i '/require("hypr.fairfax")/d' "$main"
    echo "Removed Fairfax from $main"
  fi
  [[ -f $menu ]] && edit_menu remove && echo "Removed Fairfax from the launcher menu"
  validate
  echo "Fairfax is no longer wired into Omarchy (the app itself stays installed)."
  exit 0
fi

# Refuse a key that's already taken, so nothing is silently overridden.
if command -v omarchy >/dev/null; then
  taken=$(omarchy menu keybindings --print 2>/dev/null | grep -i -E "^${key//+/\\+}[[:space:]]+→" || true)
  taken=$(echo "$taken" | grep -v -i fairfax || true)
  if [[ -n $taken ]]; then
    echo "$key is already bound: $taken" >&2
    echo "Pick another with: fairfax setup omarchy --key \"SUPER + ALT + T\"" >&2
    exit 1
  fi
fi

[[ -f $module ]] && backup "$module"
cat >"$module" <<LUA
-- Fairfax, added by \`fairfax setup omarchy\`. Remove with
-- \`fairfax setup omarchy --remove\`, or edit freely.

-- Quick Entry from anywhere: press it again to save and start the next task.
o.bind("$key", "Fairfax quick entry", "fairfax --quick")

-- Quick Entry and Settings float, centred, like the panels. Quick Entry
-- sizes itself to its contents.
o.window({ class = "^fairfax\$", title = "^Fairfax Quick Entry\$" }, { float = true, center = true })
o.window({ class = "^fairfax\$", title = "^Fairfax Settings\$" }, { float = true, center = true, size = { 760, 580 } })


-- Keep Fairfax running in the background after sign-in, so alarms arrive
-- and Quick Entry opens instantly.
o.launch_on_start("fairfax --background")
LUA
echo "Wrote $module"

if ! grep -qF 'require("hypr.fairfax")' "$main"; then
  backup "$main"
  printf '%s\n' "$require_line" >>"$main"
  echo "Loaded it from $main"
fi

edit_menu add
echo "Added a Fairfax section to the Omarchy menu ($menu)"

validate
cat <<DONE

Fairfax is wired into Omarchy:
  $key          Quick Entry from anywhere
  Super+Space        Omarchy menu → Fairfax → New Task / Today / Find a Task / Settings
  Super+Alt+Space    Apps → Fairfax
  sign-in            Fairfax starts in the background for alarms
  frfx …             add and list tasks from any terminal (try: frfx help)
DONE
