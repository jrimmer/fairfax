#compdef fairfax frfx
# zsh completion for fairfax and frfx.

_fairfax_tasks() {
  local -a tasks
  tasks=(${(f)"$(fairfax --complete ${1:-tasks} 2>/dev/null | sed 's/\t/:/')"})
  _describe -t tasks 'task' tasks
}

_fairfax_lists() {
  local -a lists
  lists=(all starred scheduled done today ${(f)"$(fairfax --complete lists 2>/dev/null)"})
  _describe -t lists 'list' lists
}

_frfx() {
  if (( CURRENT == 2 )); then
    local -a commands=(
      'ls:show a list (Today when omitted)'
      'find:search everything (search syntax)'
      'done:complete tasks by number'
      'undone:reopen tasks by number'
      'open:open Fairfax'
      'add:add a task that starts with a command word'
      'help:show usage'
      'today:show Today'
    )
    _describe -t commands 'frfx command (or type a task)' commands
    return
  fi
  case $words[2] in
    ls|list) _fairfax_lists ;;
    done) _fairfax_tasks tasks ;;
    undone) _fairfax_tasks done ;;
  esac
}

_fairfax_main() {
  local -a ctl_commands
  _arguments -C \
    '(- *)--help[show help]' \
    '(- *)--version[show version]' \
    '--db[use this database file]:database:_files' \
    '--demo[open a throwaway database with sample tasks]' \
    '--quick[open Quick Entry]' \
    '--background[start without a window, for alarms]' \
    '--open[open Quick Open]' \
    '--settings[open Settings]' \
    '--new-window[open another window]' \
    '--source[open this list first]:list:(all today starred scheduled done)' \
    '--theme-dir[read the theme from this directory]:directory:_directories' \
    '--screenshot[render offscreen to a PNG and quit]:png:_files' \
    '--size[window size for --screenshot]:size:' \
    '--edit[open the editor on this task id]:id:' \
    '--selftest[drive the UI with scripted keys]' \
    '1: :->command' \
    '*:: :->args'
  case $state in
    command)
      local -a commands=(
        'add:add a task (natural language)'
        'ctl:run an automation command'
        'mcp:run the MCP server on stdio'
        'import:import a TickTick backup, task database or iCalendar file'
        'import-mail:turn emails into tasks (Mail to Fairfax)'
        'setup:wire Fairfax into Omarchy'
      )
      _describe -t commands 'fairfax command' commands
      ;;
    args)
      case $words[1] in
        ctl)
          ctl_commands=(help url ${(f)"$(fairfax --complete ctl 2>/dev/null)"})
          (( CURRENT == 2 )) && _describe -t ctl 'automation command' ctl_commands
          ;;
        import-mail)
          _arguments '--list[destination list]:list:' \
            '--natural-language[read dates and tags from the subject]' \
            '--maildir[import a Maildir]:directory:_files -/' \
            '*:message:_files -g "*.eml"'
          ;;
        import) _files ;;
        setup)
          if (( CURRENT == 2 )); then
            _values 'target' omarchy
          else
            _arguments '--remove[undo the Omarchy setup]' '--key[Quick Entry key]:key:' '--help[show help]'
          fi
          ;;
      esac
      ;;
  esac
}

case $service in
  frfx) _frfx ;;
  *) _fairfax_main ;;
esac
