#compdef precrime pc
# zsh completion for precrime and pc.

_precrime_tasks() {
  local -a tasks
  tasks=(${(f)"$(precrime --complete ${1:-tasks} 2>/dev/null | sed 's/\t/:/')"})
  _describe -t tasks 'task' tasks
}

_precrime_lists() {
  local -a lists
  lists=(all starred scheduled done today ${(f)"$(precrime --complete lists 2>/dev/null)"})
  _describe -t lists 'list' lists
}

_pc() {
  if (( CURRENT == 2 )); then
    local -a commands=(
      'ls:show a list (Today when omitted)'
      'find:search everything (the reference app search syntax)'
      'done:complete tasks by number'
      'undone:reopen tasks by number'
      'open:open Precrime'
      'add:add a task that starts with a command word'
      'help:show usage'
      'today:show Today'
    )
    _describe -t commands 'pc command (or type a task)' commands
    return
  fi
  case $words[2] in
    ls|list) _precrime_lists ;;
    done) _precrime_tasks tasks ;;
    undone) _precrime_tasks done ;;
  esac
}

_precrime_main() {
  local -a ctl_commands
  _arguments -C \
    '(- *)--help[show help]' \
    '(- *)--version[show version]' \
    '--db[use this database file]:database:_files' \
    '--demo[open a throwaway database with sample tasks]' \
    '--quick[open Quick Entry]' \
    '--background[start without a window, for alarms]' \
    '--open[open Quick Open]' \
    '--settings[open Settings]' \
    '--new-window[open another window]' \
    '--source[open this list first]:list:(all today starred scheduled done)' \
    '--theme-dir[read the theme from this directory]:directory:_directories' \
    '--screenshot[render offscreen to a PNG and quit]:png:_files' \
    '--size[window size for --screenshot]:size:' \
    '--edit[open the editor on this task id]:id:' \
    '--selftest[drive the UI with scripted keys]' \
    '1: :->command' \
    '*:: :->args'
  case $state in
    command)
      local -a commands=(
        'add:add a task (natural language)'
        'ctl:run an automation command'
        'mcp:run the MCP server on stdio'
        'import:import a TickTick backup, the reference app database or iCalendar file'
        'setup:wire Precrime into Omarchy'
      )
      _describe -t commands 'precrime command' commands
      ;;
    args)
      case $words[1] in
        ctl)
          ctl_commands=(help url ${(f)"$(precrime --complete ctl 2>/dev/null)"})
          (( CURRENT == 2 )) && _describe -t ctl 'automation command' ctl_commands
          ;;
        import) _files -g '*.(csv|ics|db|taskdb)' ;;
        setup)
          if (( CURRENT == 2 )); then
            _values 'target' omarchy
          else
            _arguments '--remove[undo the Omarchy setup]' '--key[Quick Entry key]:key:' '--help[show help]'
          fi
          ;;
      esac
      ;;
  esac
}

case $service in
  pc) _pc ;;
  *) _precrime_main ;;
esac
