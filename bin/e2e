#!/bin/sh
# Builds and runs the end-to-end UI tests: the real QML window, driven by
# synthetic mouse and keyboard events, offscreen.
#
# The full suite is shared by FAIRFAX_E2E_SHARDS processes (default 1: one process; 3 is about twice as fast, with three processes at once) that
# run side by side, each taking the next test class nobody has started, and
# their reports are printed one after another at the end. A run of one class or one test (FAIRFAX_E2E_CLASS
# set, or a test name given as an argument) is a single process.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/e2e"
cd "$ROOT/build/e2e"

qmake6 "$ROOT/tests/e2e/fairfax_e2e.pro"
make -j"${FAIRFAX_JOBS:-$(nproc)}"

export QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1
SHARDS="${FAIRFAX_E2E_SHARDS:-1}"
if [ "$SHARDS" -le 1 ] || [ -n "${FAIRFAX_E2E_CLAIMDIR:-}" ] || [ -n "${FAIRFAX_E2E_CLASS:-}" ] || [ "$#" -gt 0 ]; then
    exec ./fairfax_e2e "$@"
fi

LOGS="$(mktemp -d)"
trap 'rm -rf "$LOGS"' EXIT
mkdir "$LOGS/claims"
PIDS=""
i=0
while [ "$i" -lt "$SHARDS" ]; do
    FAIRFAX_E2E_CLAIMDIR="$LOGS/claims" ./fairfax_e2e > "$LOGS/$i.log" 2>&1 &
    PIDS="$PIDS $!"
    i=$((i + 1))
done
status=0
i=0
for pid in $PIDS; do
    wait "$pid" || status=1
    i=$((i + 1))
done
i=0
while [ "$i" -lt "$SHARDS" ]; do
    echo "=============== shard $i of $SHARDS ==============="
    cat "$LOGS/$i.log"
    i=$((i + 1))
done
exit "$status"
